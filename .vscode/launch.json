{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug FastAPI (Mock LLM)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "console": "integratedTerminal",
      "env": {
        "LLM_MODE": "MOCK"
      }
    },
    {
      "name": "Debug FastAPI (Gemini LLM)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "console": "integratedTerminal",
      "env": {
        "LLM_MODE": "GEMINI"
      }
    }
  ]
}
