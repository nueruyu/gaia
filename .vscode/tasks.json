{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bundle Source",
      "type": "shell",
      "command": "bundle-md",
      "args": [".", "build/bundle-outputs/gaia.md"]
    },
    {
      "label": "Bundle And Copy Source",
      "type": "shell",
      "dependsOn": "Bundle Source",
      "problemMatcher": [],
      "windows": {
        "command": "Set-Clipboard -Path \"build/bundle-outputs/gaia.md\""
      },
      "osx": {
        "command": "osascript -e 'tell app \"Finder\" to set the clipboard to ( POSIX file \"build/bundle-outputs/gaia.md\" )'"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Ruff: Check & Fix",
      "type": "shell",
      "command": "poetry run ruff check --fix .",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "build"
    },
    {
      "label": "Ruff: Format",
      "type": "shell",
      "command": "poetry run ruff format .",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "build"
    },
    {
      "label": "Ruff: All (Fix & Format)",
      "dependsOn": ["Ruff: Check & Fix", "Ruff: Format"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
